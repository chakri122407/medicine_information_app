<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- App Bar / Header -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            app:title="Medicine Information"
            app:titleTextColor="?attr/colorOnPrimary" />

        <!-- User Authentication Header Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvUserStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Not signed in"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAuth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign In" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Medical Disclaimer Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="4dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="8dp"
            app:strokeColor="#FFE082"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="DISCLAIMER: Information provided is from openFDA and for informational purposes only. It is NOT medical advice."
                android:textColor="#C62828"
                android:textSize="12sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation Tabs -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Label Info &amp; Scanner" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reminders" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Main Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Section 1: Scanner & Label Info -->
            <ScrollView
                android:id="@+id/layoutScannerSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Camera & Gallery Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCaptureImage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:text="Capture Box"
                            app:icon="@android:drawable/ic_menu_camera" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickImage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Pick Image"
                            app:icon="@android:drawable/ic_menu_gallery" />

                    </LinearLayout>

                    <!-- Manual Search Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Search brand name (e.g. Tylenol)"
                            app:boxBackgroundMode="outline">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSearchQuery"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionSearch"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSearch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Search" />
                    </LinearLayout>

                    <!-- Image Preview View -->
                    <ImageView
                        android:id="@+id/ivMedicinePreview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        android:background="#E0E0E0"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- ML Kit Recognized Lines Section -->
                    <LinearLayout
                        android:id="@+id/layoutRecognizedLines"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recognized Text (Tap line to search label):"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecognizedLines"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                    <!-- Loading Progress -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone" />

                    <!-- Error / No Matches Found Text -->
                    <TextView
                        android:id="@+id/tvNotFound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="#FFEBEE"
                        android:gravity="center"
                        android:padding="16dp"
                        android:text="No matches found (HTTP 404). Please try another search or line."
                        android:textColor="#D32F2F"
                        android:textSize="15sp"
                        android:visibility="gone" />

                    <!-- openFDA Label Information Cards -->
                    <LinearLayout
                        android:id="@+id/layoutLabelResults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <!-- Main Details Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="3dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <TextView
                                    android:id="@+id/tvBrandName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Brand Name"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvGenericName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Generic Name"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/tvManufacturer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Manufacturer"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvPurpose"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Purpose"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp" />

                                <TextView
                                    android:id="@+id/tvIndications"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Indications &amp; Usage"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="14sp" />

                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Dosage Card (Expandable) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDosage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:id="@+id/headerDosage"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Dosage &amp; Administration"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/ivDosageChevron"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@android:drawable/arrow_down_float" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvDosageContent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp"
                                    android:visibility="gone"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Warnings Card (Expandable) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardWarnings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:id="@+id/headerWarnings"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Warnings"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/ivWarningsChevron"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@android:drawable/arrow_down_float" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvWarningsContent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp"
                                    android:visibility="gone"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Do Not Use Card (Expandable) -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardDoNotUse"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                                <LinearLayout
                                    android:id="@+id/headerDoNotUse"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="Do Not Use"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:id="@+id/ivDoNotUseChevron"
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:src="@android:drawable/arrow_down_float" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tvDoNotUseContent"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="14sp"
                                    android:visibility="gone"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <!-- Section 2: Reminders -->
            <LinearLayout
                android:id="@+id/layoutRemindersSection"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddReminder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Medicine Reminder"
                    app:icon="@android:drawable/ic_input_add" />

                <TextView
                    android:id="@+id/tvNoReminders"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="32dp"
                    android:text="No active reminders. Tap above to add one."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReminders"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
